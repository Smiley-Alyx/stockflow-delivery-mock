# RabbitMQ
RABBITMQ_EXCHANGE=stockflow.delivery
RABBITMQ_DLX=stockflow.delivery.dlx
RABBITMQ_REQUESTS_QUEUE=stockflow.delivery.requests
RABBITMQ_RETRY_QUEUE=stockflow.delivery.requests.retry
RABBITMQ_DLQ=stockflow.delivery.requests.dlq
RABBITMQ_SETUP_TOPOLOGY=true
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_CONSUMER_TIMEOUT_SECONDS=30
RABBITMQ_MAX_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY_MS=5000
DELIVERY_MOCK_PUBLISH_EVENTS=true
DELIVERY_MOCK_METRICS_ENABLED=true
