{
    "name": "stockflow/delivery-mock",
    "description": "External delivery provider mock for the stockflow-market case study",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "php-di/php-di": "^7.0",
        "php-amqplib/php-amqplib": "^3.7",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@install-git-hooks"
        ],
        "install-git-hooks": [
            "@php scripts/install-git-hooks.php"
        ],
        "test": "pest",
        "serve": "php -S 0.0.0.0:8082 -t public public/index.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
