{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockflow.local/contracts/messages/delivery.shipment.requested.v1.json",
  "title": "DeliveryShipmentRequestedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_id",
    "order_id",
    "delivery_address",
    "carrier_profile"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "pattern": "^shp_[a-z0-9_]+$",
      "maxLength": 64
    },
    "order_id": {
      "type": "string",
      "maxLength": 64
    },
    "delivery_address": {
      "$ref": "./common/delivery-address.json"
    },
    "carrier_profile": {
      "$ref": "./common/carrier-profile.json"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
