{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockflow.local/contracts/messages/delivery.shipment.cancelled.v1.json",
  "title": "DeliveryShipmentCancelledV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_id",
    "order_id",
    "status",
    "cancelled_at"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "pattern": "^shp_[a-z0-9_]+$",
      "maxLength": 64
    },
    "order_id": {
      "type": "string",
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "const": "cancelled"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    }
  }
}
