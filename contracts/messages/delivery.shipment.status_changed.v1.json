{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockflow.local/contracts/messages/delivery.shipment.status_changed.v1.json",
  "title": "DeliveryShipmentStatusChangedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_id",
    "order_id",
    "previous_status",
    "current_status",
    "changed_at"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "pattern": "^shp_[a-z0-9_]+$",
      "maxLength": 64
    },
    "order_id": {
      "type": "string",
      "maxLength": 64
    },
    "previous_status": {
      "$ref": "./common/shipment-status.json"
    },
    "current_status": {
      "$ref": "./common/shipment-status.json"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    },
    "tracking_number": {
      "type": "string",
      "maxLength": 64
    }
  }
}
