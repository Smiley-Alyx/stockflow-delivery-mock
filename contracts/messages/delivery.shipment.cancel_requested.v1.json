{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockflow.local/contracts/messages/delivery.shipment.cancel_requested.v1.json",
  "title": "DeliveryShipmentCancelRequestedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_id",
    "order_id"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "pattern": "^shp_[a-z0-9_]+$",
      "maxLength": 64
    },
    "order_id": {
      "type": "string",
      "maxLength": 64
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
